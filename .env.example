# Supabase — used for early-access emails, feedback, lightweight usage
# analytics, and (once set) accounts/login and the credits system. The
# app runs fine without these set for the non-account features: writes
# are skipped with a console warning instead of failing. See
# /sql/schema.sql for the tables/functions to create once you provision
# a project. Without these set, login/register show a "not configured"
# message rather than failing.
NEXT_PUBLIC_SUPABASE_URL=
# Safe to expose to the browser — this is Supabase's public/anon key,
# used only for auth (sign up / sign in), never for direct table access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — used only by "Run Analysis". Every successful click spends
# real money on whatever key you put here (plus web-search costs — see
# ANTHROPIC_ENABLE_WEB_SEARCH below). Without it, "Run Analysis" shows a
# friendly "not configured" message instead of failing, and Copy Prompt
# still works normally.
ANTHROPIC_API_KEY=
# Defaults to claude-sonnet-5 (a deliberately cost-conscious choice, not
# the top-tier model) if left blank. Change to e.g. claude-opus-5 for
# higher-quality analysis at higher cost.
ANTHROPIC_MODEL=
# Set to "false" to disable the web-search tool on Run Analysis (it's on
# by default). Web search adds metered cost on top of normal token cost
# — check current Anthropic pricing before enabling for real users.
ANTHROPIC_ENABLE_WEB_SEARCH=

# Stripe — used by "Buy Credits" and membership subscriptions. Without
# these set, both show a "not available yet" message instead of erroring.
# Get these from your Stripe dashboard once you're ready to connect it.
STRIPE_SECRET_KEY=
# From the Stripe CLI or your webhook endpoint settings — required to
# verify that webhook requests genuinely came from Stripe.
STRIPE_WEBHOOK_SECRET=
# Price ID for the one-time "Buy Credits" pack (create a one-time Price
# in Stripe first). How many credits it grants is set in
# src/content/membership.config.ts, not here.
STRIPE_PRICE_ID_CREDITS_PACK=
