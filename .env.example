# Supabase — used for early-access emails, feedback, and lightweight usage
# analytics. The app runs fine without these set: writes are skipped with
# a console warning instead of failing. See /sql/schema.sql for the
# tables to create once you provision a project.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — used only by "Run Analysis". Every click that uses this
# spends real money on whatever key you put here. Without it, "Run
# Analysis" shows a friendly "not configured" message instead of
# failing, and Copy Prompt still works normally.
ANTHROPIC_API_KEY=
# Defaults to claude-sonnet-5 (a deliberately cost-conscious choice, not
# the top-tier model) if left blank. Change to e.g. claude-opus-5 for
# higher-quality analysis at higher cost.
ANTHROPIC_MODEL=
